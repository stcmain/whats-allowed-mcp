{
  "name": "whats-allowed-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.stcmain/whats-allowed-mcp",
  "description": "MCP server that shows what your coding agent can do without asking you: every settings file that contributes permission rules, which one wins, what runs unattended, and the rules Claude Code accepts and then ignores.",
  "type": "module",
  "bin": {
    "whats-allowed-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "agents",
    "permissions",
    "settings",
    "security",
    "audit",
    "guardrails",
    "hooks"
  ],
  "author": "Zachary Pampu <info@shifttheculture.media>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stcmain/whats-allowed-mcp.git"
  },
  "homepage": "https://github.com/stcmain/whats-allowed-mcp#readme",
  "bugs": {
    "url": "https://github.com/stcmain/whats-allowed-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
